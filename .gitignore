# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage
*.lcov

# Next.js build output & cache
/.next/
/out/
/build

# Debug & system logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*
*.log

# Operating System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Environment secret files
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert

# Vercel & Turbo build artifacts
.vercel
.turbo

# TypeScript & Next build metadata
*.tsbuildinfo
next-env.d.ts

# IDE & Editor folders
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# AI Agent & Assistant cached skill directories
.agents/
.claude/
.cursor/
.devin/

# Local SQLite / temporary test databases
*.db
*.sqlite
*.sqlite3

